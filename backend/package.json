{
  "name": "quanlybannuoc-backend",
  "version": "1.0.0",
  "description": "Backend API Node.js cho app QuanLyBanNuoc",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ../scripts/run-node.js server.js",
    "dev": "npm start",
    "test": "node ../scripts/run-node.js --require ./test/setup-crypto.js --test test/*.test.js",
    "check:gemini": "node ../scripts/run-node.js scripts/check-gemini.js",
    "reset-db": "node ../scripts/run-node.js reset-db.js",
    "seed": "node ../scripts/run-node.js seed_food.js",
    "setup": "npm run reset-db && npm run seed",
    "migrate:security": "node ../scripts/run-node.js scripts/migrate-security.js",
    "migrate:login-security": "node ../scripts/run-node.js scripts/migrate-login-security.js",
    "crypto:init": "node ../scripts/run-node.js scripts/init-crypto.js",
    "migrate:storage": "node ../scripts/run-node.js scripts/migrate-storage.js",
    "migrate:avatars": "node ../scripts/run-node.js scripts/migrate-avatars.js"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "sharp": "0.35.5",
    "vnpay": "2.5.0"
  }
}
