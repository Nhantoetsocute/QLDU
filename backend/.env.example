# ============================================================
# QuanLyBanNuoc Backend — Environment Variables
# ============================================================
# Copy file này thành .env rồi điền giá trị phù hợp:
#   cp .env.example .env
# ============================================================

# Server
PORT=3000

# MySQL Database (XAMPP mặc định)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=quanlybannuoc

# JWT Authentication
JWT_SECRET=

# VNPay Sandbox Configuration
# Đăng ký tài khoản sandbox tại: https://sandbox.vnpayment.vn/
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vnapigw-vnpay/VnpPayment.html
VNP_RETURN_URL=http://localhost:3000/api/vnpay/return
VNP_HOST=https://sandbox.vnpayment.vn
VNP_TEST_MODE=true

# Email Configuration
EMAIL_USER=example@gmail.com
EMAIL_PASS="16_ky_tu_app_password"

# Gemini chatbot — key CHỈ ở backend, không dùng EXPO_PUBLIC_*.
# Dùng key từ dự án Free Tier chưa bật billing; model cũng có Paid Tier.
# Code không kích hoạt billing, không đổi model và không tự retry khi hết quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Origin công khai dùng cho URL ảnh; production bắt buộc HTTPS.
PUBLIC_BASE_URL=
# Các web origin được phép, phân tách bằng dấu phẩy. Native app không cần Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Production: Node chỉ lắng nghe loopback sau reverse proxy TLS.
# NODE_ENV=production
# HOST=127.0.0.1
# TRUST_PROXY=loopback
# PUBLIC_BASE_URL=https://api.example.com
# VNP_RETURN_URL=https://api.example.com/api/vnpay/return
# CORS_ORIGINS=https://app.example.com

# DB từ xa trong production bắt buộc TLS, DB_HOST là DNS khớp chứng chỉ.
DB_TLS=false
DB_SSL_CA=

# Nhóm 9–10: dùng npm run crypto:init để tạo keyring cục bộ 700/600.
# Production nên lấy khóa từ secret manager, giữ tách khỏi database/backups.
# CRYPTO_KEYS_FILE=/secure/path/crypto-keys.json
# Hoặc cung cấp ĐỦ 4 biến sau; mỗi khóa base64 phải độc lập và đúng 32 byte:
# DATA_ENCRYPTION_KEYS={"key-v1":"<base64-32-byte-key>"}
# DATA_ENCRYPTION_ACTIVE_KEY_ID=key-v1
# OTP_HMAC_KEY=<base64-32-byte-key>
# DATA_INDEX_KEY=<base64-32-byte-key>
BCRYPT_ROUNDS=12
