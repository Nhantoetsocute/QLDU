# Development: origin HTTP trong LAN, ví dụ http://192.168.1.20:3000.
# Release: bắt buộc HTTPS, không có đường dẫn/query/credentials.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_PORT=3000
# Chỉ đặt APP_VARIANT=development khi dựng binary phục vụ phát triển cục bộ.
# APP_VARIANT=development
# Không đặt API keys hoặc mật khẩu trong EXPO_PUBLIC_*.
